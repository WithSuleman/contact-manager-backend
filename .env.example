# MongoDB Atlas connection string
# Replace with your actual username, password, and cluster host
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/contact_manager?retryWrites=true&w=majority

# Port where Express server runs
PORT=5000

# Client origin for CORS (Vercel URL in production or localhost in development)
CLIENT_URL=http://localhost:5173
